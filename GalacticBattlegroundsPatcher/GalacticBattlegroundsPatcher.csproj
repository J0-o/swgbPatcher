<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>GalacticBattlegroundsLauncher</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KPatchCore\KPatchCore.csproj" />
    <EmbeddedResource Include="..\bin\Release\GalacticBattlegroundsPatcher.Runtime.dll"
          LogicalName="GalacticBattlegroundsPatcher.Runtime.dll"
          Condition="Exists('..\bin\Release\GalacticBattlegroundsPatcher.Runtime.dll')" />
  </ItemGroup>
</Project>
